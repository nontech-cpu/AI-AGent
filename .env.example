# ==========================================
# PeculiarAI Environment Configuration Template
# Fill in your company / deployment credentials
# ==========================================

# Core Telegram Bots
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_BOT_USERNAME="your_telegram_bot_username"
TELEGRAM_OTP_BOT_TOKEN=""
TELEGRAM_OTP_BOT_USERNAME=""
WEBHOOK_SECRET="generate_a_random_32_char_secret_here"

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# AI Model Providers (Google Gemini & Groq)
GEMINI_API_KEY="your_gemini_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"
GEMINI_API_KEY_BACKUP=""
GROQ_API_KEY_BACKUP=""
GROQ_MODEL="llama-3.3-70b-versatile"
AGENT_CORE="v2"

# Security & Field-Level Column Encryption
AES_SECRET_KEY="generate_32_byte_hex_key_here"

# Google Workspace (OAuth2, Calendar, Drive, Meet, Gmail)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_TOKEN_KEY="your_token_encryption_key"
BOT_EMAIL=""
BOT_EMAIL_APP_PASSWORD=""

# Search & Grounding Providers
SERPER_API_KEY=""
TAVILY_API_KEY=""

# Integrations (Optional)
GITHUB_TOKEN=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
NOTION_API_KEY=""
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

# Travel Transit Tracking (Optional)
RAPIDAPI_KEY=""
AVIATIONSTACK_API_KEY=""

# App URLs
PUBLIC_BASE_URL="https://your-domain.onrender.com"
FASTAPI_BASE_URL="https://your-domain.onrender.com"
