# Existing FastAPI backend
FASTAPI_BASE_URL=http://127.0.0.1:8000

# Set the WhatsApp Business chat link when available, e.g. https://wa.me/<business-number>
WHATSAPP_CHAT_URL=

# Temporary fallback: existing Telegram bot username without @
TELEGRAM_BOT_USERNAME=

# Google OAuth Web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the Authorized redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:8501
